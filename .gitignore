# Strict reviewed allowlist: original code, all notebooks, datasets, results,
# checkpoints, old tests, backups and unlisted files remain local and ignored.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/requirements.txt
!/gradcam_dev_demo.py
!/cnn_face_experiment/
/cnn_face_experiment/*
!/cnn_face_experiment/__init__.py
!/cnn_face_experiment/crops.py
!/cnn_face_experiment/preprocessing.py
!/cnn_face_experiment/experiments.py
!/cnn_face_experiment/reporting.py
!/cnn_face_experiment/explain.py
!/cnn_face_experiment/requirements.txt
!/cnn_face_experiment/YUNET_LICENSE.txt

!/cnn_experiment/
/cnn_experiment/*
!/cnn_experiment/__init__.py
!/cnn_experiment/backup.py
!/cnn_experiment/checkpoints.py
!/cnn_experiment/config.py
!/cnn_experiment/data.py
!/cnn_experiment/evaluation.py
!/cnn_experiment/final_evaluation.py
!/cnn_experiment/github.py
!/cnn_experiment/models.py
!/cnn_experiment/training.py
!/cnn_experiment/workflow.py
!/cnn_experiment/pool.py
!/cnn_experiment/temporal.py
!/cnn_experiment/calibration.py
!/cnn_experiment/gradcam.py
!/cnn_experiment/reporting.py

!/tests/
/tests/*
!/tests/__init__.py
!/tests/test_backup.py
!/tests/test_data.py
!/tests/test_github.py
!/tests/test_training_progress.py
!/tests/test_training_state.py
!/tests/test_workflow.py
!/tests/test_fixed_pool.py
!/tests/test_temporal.py
!/tests/test_calibration.py
!/tests/test_gradcam.py
!/tests/test_face_experiment.py
!/tests/test_reporting.py
!/tests/test_face_preprocessing.py
!/tests/test_face_finalization.py

!/docs/
/docs/*
!/docs/KAGGLE_SETUP.md
!/docs/EXPERIMENT_METHODOLOGY.md
!/docs/GRADCAM.md
!/docs/FACE_CNN_EXPERIMENTS.md

